# ─────────────────────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────────────────────
node_modules/

# ─────────────────────────────────────────────────────────────────────────────
# Build Output
# ─────────────────────────────────────────────────────────────────────────────
# Wails build artifacts
wails/build/bin/
wails/frontend/dist/
# .gitkeep inside it is tracked on purpose. //go:embed all:frontend/dist
# refuses to compile against a directory with nothing in it, and the `all:`
# prefix counts a dotfile as something. index.html and logo.svg used to be
# tracked for that job, but they are build output: every frontend build
# rewrote index.html with new asset hashes, so a generated file nobody reads
# turned up in unrelated commits.
!wails/frontend/dist/.gitkeep

# Compiled binaries
*.exe
*.app
*.dmg
*.AppImage
*.deb
*.rpm

# Wails regenerates these on every Windows build (icon/version resource object
# and the rendered NSIS helper); build/windows/installer/project.nsi is the
# only installer file that belongs in the repository.
*.syso
wails/build/windows/installer/wails_tools.nsh

# ─────────────────────────────────────────────────────────────────────────────
# IDE / Editor
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────────────────────
# OS Generated
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
nul

# ─────────────────────────────────────────────────────────────────────────────
# Logs / Debug
# ─────────────────────────────────────────────────────────────────────────────
*.log

# Private manuscript diagnostics, experiment notes and generated reports.
# Never publish these with source code or public documentation.
.diag/
*.draftline
*.epub

# ─────────────────────────────────────────────────────────────────────────────
# Static-analysis output (huge; findings are distilled into markdown reports)
# ─────────────────────────────────────────────────────────────────────────────
*.sarif
*.sarif.json

# Book claim sidecars, written beside a book while it is open
*.draftline.lock

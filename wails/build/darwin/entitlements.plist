<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements applied by the release workflow when a
     Developer ID certificate is configured. Unsigned/ad-hoc builds ignore
     this file.
     - allow-jit / allow-unsigned-executable-memory: required by WKWebView's
       JavaScript engine.
     - disable-library-validation: the read-aloud feature dlopens the
       onnxruntime / sherpa-onnx libraries it downloads at runtime, which are
       not signed with our Team ID. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key><true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
	<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
